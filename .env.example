/**
 * This file documents environment variables for the MadGarage frontend.
 * Copy this file to .env.development (do NOT commit .env files with real values).
 *
 * Expo reads variables prefixed with EXPO_PUBLIC_ at build time.
 * See: https://docs.expo.dev/guides/environment-variables/
 */

# Base URL of the Spring Boot API server (no trailing slash, no /api suffix).
# Dev (Expo Go - local network):
EXPO_PUBLIC_API_URL=http://192.168.1.5:8080
# Staging:
# EXPO_PUBLIC_API_URL=https://staging-api.madgarage.com
# Production:
# EXPO_PUBLIC_API_URL=https://api.madgarage.com

# Razorpay Test Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyHere
